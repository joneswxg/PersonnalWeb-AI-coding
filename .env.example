# Local dev: docker compose up -d, then DATABASE_URL below matches docker-compose.yml.
# Production: set this to your Neon Postgres connection string instead.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/personal_learning_blog

# GitHub OAuth App (create at https://github.com/settings/developers).
# Authorization callback URL: <your-deployed-url>/api/auth/callback/github
# For local dev, register a separate dev OAuth App with callback:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth.js session encryption secret. Generate with: openssl rand -base64 33
AUTH_SECRET=

# The GitHub username that always resolves to the "owner" role.
OWNER_GITHUB_USERNAME=

# Server-only token for reading public repository metadata and language totals.
# A fine-grained token with public-repository read access is sufficient.
GITHUB_TOKEN=
